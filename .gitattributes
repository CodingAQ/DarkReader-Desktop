# Default to auto-normalized text with LF in the repo.
* text=auto eol=lf

# Windows-specific sources use CRLF in the working tree.
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.config  text eol=crlf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary file types — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.bmp  binary
*.psd  binary
*.pdf  binary
*.exe  binary
*.dll  binary
*.pdb  binary
*.zip  binary
*.7z   binary
*.gz   binary
